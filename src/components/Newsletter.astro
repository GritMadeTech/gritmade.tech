---
// Beehiiv signup. The form POSTs to a Cloudflare Worker (see /worker) that
// holds the API key, forwards to Beehiiv, then redirects to /thanks. No
// third-party JS runs on the page. After deploying the Worker, paste its URL
// below (https://gritmade-subscribe.<your-subdomain>.workers.dev).
const SUBSCRIBE_ENDPOINT = "https://gritmade-subscribe.iapcsolutions.workers.dev";
---

<section class="border border-stone-900 p-6 sm:p-8">
  <h2 class="font-mono text-lg text-stone-100">Follow the build</h2>
  <p class="mt-2 text-sm text-stone-400">
    New apps, experiments, and architecture notes — delivered when they ship.
  </p>
  <form
    action={SUBSCRIBE_ENDPOINT}
    method="POST"
    class="mt-5 flex flex-col gap-3 sm:flex-row"
  >
    <label for="email" class="sr-only">Email address</label>
    <input
      id="email"
      type="email"
      name="email"
      required
      autocomplete="email"
      placeholder="you@domain.com"
      class="flex-1 border border-stone-800 bg-stone-950 px-3 py-2 font-mono text-sm text-stone-100 placeholder:text-stone-600 focus:border-amber-600 focus:outline-none"
    />
    <button
      type="submit"
      class="bg-amber-600 px-4 py-2 font-mono text-sm text-stone-950 transition-colors hover:bg-amber-500"
    >
      subscribe
    </button>
  </form>
</section>
