---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Subscribed" description="You're on the list.">
  <header>
    <h1 class="font-mono text-2xl text-stone-100 sm:text-3xl">You're in.</h1>
  </header>

  <section class="mt-10 space-y-4 text-stone-300">
    <p>
      Thanks for subscribing — new apps, experiments, and architecture notes
      will land in your inbox when they ship.
    </p>
    <p>
      <a
        href="/"
        class="font-mono text-sm text-stone-300 transition-colors hover:text-amber-600"
      >
        ← back home
      </a>
    </p>
  </section>
</BaseLayout>
