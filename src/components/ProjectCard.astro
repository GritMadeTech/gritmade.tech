---
import StatusBadge from "./StatusBadge.astro";

interface Props {
  title: string;
  description: string;
  status: "live" | "building" | "experiment";
  link?: string;
  repo?: string;
}
const { title, description, status, link, repo } = Astro.props;
---

<article class="border border-stone-900 p-6 transition-colors hover:border-stone-700">
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-mono text-stone-100">{title}</h3>
    <StatusBadge status={status} />
  </div>
  <p class="mt-2 text-sm text-stone-400">{description}</p>
  {
    (link || repo) && (
      <div class="mt-4 flex gap-4 font-mono text-xs">
        {link && (
          <a
            href={link}
            target="_blank"
            rel="noopener"
            class="text-amber-600 transition-colors hover:text-amber-500"
          >
            demo →
          </a>
        )}
        {repo && (
          <a
            href={repo}
            target="_blank"
            rel="noopener"
            class="text-stone-400 transition-colors hover:text-stone-100"
          >
            repo →
          </a>
        )}
      </div>
    )
  }
</article>
